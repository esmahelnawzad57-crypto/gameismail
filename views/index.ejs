<!DOCTYPE html>
<html lang="ckb" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Skribblrs.io - یاری کێشان و پێشبینیکردن</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <link rel="stylesheet" href="css/index.css">
    <link rel="preload" href="audio/click.mp3" as="audio">
    <link rel="preload" href="audio/your-turn.mp3" as="audio">
    <link rel="preload" href="audio/clock.mp3" as="audio">
    <link rel="preload" href="audio/correct.mp3" as="audio">
    <link rel="preload" href="audio/gameover.mp3" as="audio">
    <link rel="preload" href="audio/pop.mp3" as="audio">
    <link rel="preload" href="audio/exit.mp3" as="audio">
    <link rel="preload" href="audio/timer-start.mp3" as="audio">
    <link rel="preload" href="audio/hint.mp3" as="audio">
</head>

<body>
    <div class="bg-mesh-container" aria-hidden="true">
        <div class="mesh-orb mesh-orb-1"></div>
        <div class="mesh-orb mesh-orb-2"></div>
        <div class="mesh-orb mesh-orb-3"></div>
        <div class="mesh-grid-overlay"></div>
    </div>

    <main class="main-content">
        <%- include('partials/landing', { roomID }) %>
        <%- include('partials/settings', { roomID }) %>
        <%- include('partials/gameZone') %>
        <%- include('partials/gameEnd') %>
    </main>

    <!-- 1. Socket.IO Client Library -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Initialize global socket instance
        const socket = io();
    </script>
    
    <!-- 2. Audio and Sketchpad Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/howler@2.2.1/dist/howler.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/responsive-sketchpad/dist/sketchpad.min.js"></script>
    
    <!-- 3. Application Scripts -->
    <script src="js/avatar.js"></script>
    <script src="js/canvas.js"></script>
    <script src="js/settings.js"></script>
    <script src="js/game.js"></script>
</body>

</html>
