<section class="container-fluid px-lg-5 d-none" id="gameZone">
    <div class="glass-panel py-2 px-3 rounded-0 mb-3" style="border-radius: 12px !important;">
        <div class="row align-items-center text-white mx-0">
            <div class="col-2 text-start">
                <div class="d-inline-block px-3 py-1 bg-danger rounded-pill fw-bold h4 mb-0 shadow" id="clock">0</div>
            </div>
            <div class="col-10 text-center" id="wordDiv">
                <p class="lead mb-0 text-muted">چاوەڕوانی دەستپێکردنی یاری بە...</p>
            </div>
        </div>
    </div>
    
    <div class="row justify-content-center mx-0">
        <div class="col-3 col-lg-2 players px-1"></div>
        
        <div class="col-9 col-lg-7 d-flex flex-column px-1 px-lg-3">
            <div id="sketchpad" class="text-center w-100 bg-white" style="border-radius: 12px; overflow: hidden;"></div>
            <%- include('tools') %>
        </div>
        
        <div class="col-12 col-lg-3 glass-panel p-2 mt-3 mt-lg-0 text-white d-flex flex-column justify-content-between">
            <div class="messages flex-grow-1 mb-2"></div>
            <form id="sendMessage" class="mt-auto">
                <input class="form-control text-end" type="text" placeholder="پێشبینییەکەت لێرە بنووسە و ئینتەر بکە...">
                <div class="position-relative">
                    <ul class="list-group mt-1" id="suggestions"></ul>
                </div>
            </form>
        </div>
    </div>
</section>