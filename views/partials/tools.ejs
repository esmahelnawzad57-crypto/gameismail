<% const colorClasses=["white", "grey1" , "red1" , "orange1" , "yellow1" , "green1" , "skyblue1" , "blue1" , "purple1"
    , "pink1" , "brown1" , "black" , "grey2" , "red2" , "orange2" , "yellow2" , "green2" , "skyblue2" , "blue2"
    , "purple2" , "pink2" , "brown2" ] %>

<div class="row mx-0 d-none align-items-center g-2" id="tools">
    <!-- Active Selected Color Preview -->
    <div class="col-auto px-1">
        <div class="selected-color" title="ڕەنگی هەڵبژێردراو"></div>
    </div>

    <!-- Color Palette Grid -->
    <div class="col px-1">
        <div class="d-flex flex-wrap align-items-center palette-container">
            <div class="d-inline-flex align-top">
                <% for(let i=0; i < 11; i++) { %>
                    <div class="color <%= colorClasses[i] %>" role="button" title="ڕەنگ"></div>
                <% } %>
            </div>
            <div class="d-inline-flex">
                <% for(let i=11; i < 22; i++) { %>
                    <div class="color <%= colorClasses[i] %>" role="button" title="ڕەنگ"></div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Brush Sizes, Eraser & Clear Actions -->
    <div class="col-auto px-1 d-flex align-items-center justify-content-end tool-actions">
        <!-- Small Brush (5px) -->
        <button type="button" class="tool-btn brush-btn active" id="sm-brush" data-linesize="5" title="فڵچەی بچووک (٥)" aria-label="فڵچەی بچووک">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <circle cx="12" cy="12" r="2.5"/>
            </svg>
        </button>

        <!-- Medium Brush (10px) -->
        <button type="button" class="tool-btn brush-btn" id="md-brush" data-linesize="10" title="فڵچەی ناوەند (١٠)" aria-label="فڵچەی ناوەند">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <circle cx="12" cy="12" r="4.5"/>
            </svg>
        </button>

        <!-- Large Brush (15px) -->
        <button type="button" class="tool-btn brush-btn" id="lg-brush" data-linesize="15" title="فڵچەی گەورە (١٥)" aria-label="فڵچەی گەورە">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <circle cx="12" cy="12" r="6.5"/>
            </svg>
        </button>

        <!-- Extra Large Brush (20px) -->
        <button type="button" class="tool-btn brush-btn" id="xl-brush" data-linesize="20" title="فڵچەی زۆر گەورە (٢٠)" aria-label="فڵچەی زۆر گەورە">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <circle cx="12" cy="12" r="8.5"/>
            </svg>
        </button>

        <!-- Eraser Tool -->
        <button type="button" class="tool-btn" id="eraser" title="سڕینەوە" aria-label="سڕینەوە">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/>
                <path d="M22 21H7"/>
                <path d="m5 11 9 9"/>
            </svg>
        </button>

        <!-- Clear Canvas -->
        <button type="button" class="tool-btn btn-clear" id="clearCanvas" title="پاککردنەوەی تەختە" aria-label="پاککردنەوەی تەختە">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"/>
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                <line x1="10" y1="11" x2="10" y2="17"/>
                <line x1="14" y1="11" x2="14" y2="17"/>
            </svg>
        </button>
    </div>
</div>
