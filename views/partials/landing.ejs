<section class="container" id="landing">
    <div class="row justify-content-center mx-0">
        <div class="col-lg-6 glass-panel p-4 text-white">
            <h2 class="text-center mb-4 fw-bold text-info" style="text-shadow: 0 0 10px rgba(0,242,254,0.3);">بەخێربێیت بۆ وێنەکێش و دۆزەرەوە</h2>
            
            <div class="form-floating mb-3 text-dark">
                <input type="text" class="form-control" id="playerName" placeholder="ناو لێرە بنووسە" required>
                <label for="playerName">ناوەکەت</label>
            </div>
            
            <div class="row justify-content-center align-items-center mx-0">
                <div class="col-6 col-sm-5 text-center">
                    <img id="avatar" class="img-fluid rounded-circle mb-4 mb-sm-0 border border-3 border-info"
                        src="https://avatars.dicebear.com/4.5/api/avataaars/.svg" alt="Avatar">
                </div>
                <div class="col-sm-7">
                    <div class="input-group mb-3">
                        <label class="input-group-text" for="style">شێواز</label>
                        <select class="form-select" id="style">
                            <option value="Avataaars" selected>مۆدێرن (Avataaars)</option>
                            <option value="Bottts">ڕۆبۆت (Bottts)</option>
                            <option value="Female">کچانە (Female)</option>
                            <option value="Gridy">پێکسڵ (Gridy)</option>
                            <option value="Human">مرۆڤ (Human)</option>
                            <option value="Identicon">شێوە (Identicon)</option>
                            <option value="Initials">پیت (Initials)</option>
                            <option value="Jdenticon">هێما (Jdenticon)</option>
                            <option value="Male">کوڕانە (Male)</option>
                        </select>
                    </div>
                    <div class="input-group mb-3">
                        <label class="input-group-text" for="bgColor">ڕەنگی پشتێنە</label>
                        <input type="color" class="form-control form-control-color" id="bgColor" value="#1a1a2e"
                            title="ڕەنگێک هەڵبژێرە">
                    </div>
                </div>
                
                <% if(!roomID) { %>
                    <button class="btn btn-primary mt-4 py-2 h5 fw-bold" id="createRoom">دروستکردنی ژووری تایبەت ➕</button>
                <% } else { %>
                    <button class="btn btn-primary mt-4 py-2 h5 fw-bold" id="playGame">چوونە ناو ژوور 🚪</button>
                <% } %>
            </div>
        </div>
    </div>
</section>