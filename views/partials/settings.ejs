<section class="container d-none" id="settings">
    <div class="row justify-content-between g-4 mx-0">
        <div class="col-md-6 order-2 order-md-0 glass-panel h-100 p-4">
            <h1 class="text-center section-title mb-4">ڕێکخستنەکان</h1>
            <div class="input-group mb-3">
                <label class="input-group-text" for="rounds">خولەکان</label>
                <select class="form-select" id="rounds">
                    <option value="2" selected>2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                    <option value="9">9</option>
                    <option value="10">10</option>
                </select>
            </div>
            <div class="input-group mb-3">
                <label class="input-group-text" for="time">کاتی کێشان بە چرکە</label>
                <select class="form-select" id="time">
                    <option value="30">30</option>
                    <option value="40" selected>40</option>
                    <option value="50">50</option>
                    <option value="60">60</option>
                    <option value="70">70</option>
                    <option value="80">80</option>
                    <option value="90">90</option>
                    <option value="100">100</option>
                    <option value="110">110</option>
                    <option value="120">120</option>
                    <option value="130">130</option>
                    <option value="140">140</option>
                    <option value="150">150</option>
                    <option value="160">160</option>
                    <option value="170">170</option>
                    <option value="180">180</option>
                </select>
            </div>
            <% if(!roomID) { %>
            <div class="input-group mb-3">
                <label class="input-group-text" for="customWords">وشەی تایبەت</label>
                <textarea class="form-control" placeholder="وشەی ١&#10;وشەی ٢&#10;وشەی ٣" id="customWords"
                    style="height: 18vh; resize:none"></textarea>
            </div>
            <div class="mb-4">
                <label for="probability" class="form-label text-secondary fw-bold">ئەگەری دەرکەوتنی وشەی تایبەت</label>
                <input type="range" class="form-range" min="0" max="1" step="0.01" id="probability">
            </div>
            <% } %>
            <button class="btn btn-primary btn-lg w-100 mt-2" id="startGame">دەستپێکردنی یاری</button>
        </div>
        <div class="col-md-6 glass-panel h-100 p-4">
            <h1 class="text-center section-title mb-4">یاریزانەکان</h1>
            <div class="row mt-2 mx-0" style="height: 20em; overflow-y: auto;" id="playersDiv"></div>
        </div>
    </div>
    <div class="mt-4 glass-card p-3 p-md-4">
        <h2 class="text-center h4 mb-3 text-gradient">هاوڕێکانت بانگهێشت بکە!</h2>
        <div class="input-group">
            <input type="text" id="gameLink" class="form-control text-center fw-bold"
                value="http://localhost:3000/" readonly>
            <button class="btn btn-warning px-4" type="button" id="copy">کۆپیکردنی بەستەر</button>
        </div>
    </div>
</section>
